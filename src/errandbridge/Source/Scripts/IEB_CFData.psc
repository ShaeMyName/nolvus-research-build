    ElseIf i == 7   ; Gelebor
        Return IEB_CFLib.AliasHolds(a, 0x0069CFA7, "Relationship Dialogue Overhaul.esp", 0) && a.IsPlayerTeammate()
    ElseIf i == 8   ; Isran
